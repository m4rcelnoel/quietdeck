        }
      }
    },
    "Off by default. QuietDeck asks GitHub once a day, and GitHub sees your IP address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. QuietDeck fragt einmal täglich bei GitHub nach, und GitHub sieht dabei deine IP-Adresse."
          }
        }
      }
    },
